{
  "name": "URC 2027 communications simulation",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "PYTHONUNBUFFERED": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "postCreateCommand": "./scripts/build_codec.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Communications simulation dashboard (keep private)",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  }
}
